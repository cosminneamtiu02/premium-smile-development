{
  "name": "premium-smile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && next-image-export-optimizer && node tools/generate-root-redirect.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "visual": "playwright test tests/visual",
    "visual:update": "playwright test tests/visual --update-snapshots"
  },
  "dependencies": {
    "next": "~16.2.12",
    "next-image-export-optimizer": "~1.20.1",
    "next-intl": "~4.13.6",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "sharp": "~0.35.3"
  },
  "devDependencies": {
    "@mdx-js/loader": "~3.1.1",
    "@mdx-js/react": "~3.1.1",
    "@next/mdx": "~16.2.12",
    "@playwright/test": "~1.62.1",
    "@storybook/addon-a11y": "~10.5.8",
    "@storybook/addon-vitest": "~10.5.8",
    "@storybook/nextjs-vite": "~10.5.8",
    "@tailwindcss/postcss": "~4.3.3",
    "@testing-library/dom": "~10.4.1",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.2",
    "@testing-library/user-event": "~14.6.4",
    "@types/node": "~24.13.3",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@vitest/browser": "~4.1.10",
    "@vitest/browser-playwright": "~4.1.10",
    "eslint": "~9.39.5",
    "eslint-config-next": "~16.2.12",
    "eslint-plugin-jsx-a11y": "~6.10.2",
    "linkinator": "~8.0.3",
    "prettier": "~3.9.6",
    "schema-dts": "~2.0.0",
    "storybook": "~10.5.5",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.3",
    "vitest": "~4.1.10"
  }
}
